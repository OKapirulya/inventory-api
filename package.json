{
  "name": "inventory-api",
  "version": "1.0.0",
  "description": "REST API for inventory management: Node.js, Hono, PostgreSQL, Redis, Docker",
  "main": "dist/index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "migrate": "tsx src/db/migrate.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OKapirulya/inventory-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/OKapirulya/inventory-api/issues"
  },
  "homepage": "https://github.com/OKapirulya/inventory-api#readme",
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/prometheus": "^1.0.3",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.5",
    "hono": "^4.13.12",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "redis": "^6.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/pino": "^7.0.4",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
